{
  "name": "iris-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A product-neutral React application template and reusable UI system",
  "main": "dist/iris-ui.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/iris-ui.js" },
    "./styles.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:library": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
